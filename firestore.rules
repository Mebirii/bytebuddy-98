rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function verified(uid) {
      return owner(uid) && request.auth.token.email_verified == true;
    }
    match /trainerProfiles/{uid} {
      allow get: if owner(uid);
      allow list, update, delete: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['handle','displayName','createdAt'])
        && request.resource.data.keys().hasAll(['handle','displayName','createdAt'])
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('^[a-z][a-z0-9_]{2,19}$')
        && request.resource.data.displayName == request.resource.data.handle
        && request.resource.data.createdAt == request.time;
    }
    match /trainerSaves/{uid} {
      allow get: if verified(uid);
      allow list, delete: if false;
      allow create: if verified(uid)
        && request.resource.data.keys().hasOnly(['dataJson','revision','updatedAt'])
        && request.resource.data.keys().hasAll(['dataJson','revision','updatedAt'])
        && request.resource.data.dataJson is string
        && request.resource.data.dataJson.size() <= 180000
        && request.resource.data.revision == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if verified(uid)
        && request.resource.data.keys().hasOnly(['dataJson','revision','updatedAt'])
        && request.resource.data.keys().hasAll(['dataJson','revision','updatedAt'])
        && request.resource.data.dataJson is string
        && request.resource.data.dataJson.size() <= 180000
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
